Project ierri_modelagem_usuarios {
  database_type: 'MongoDB'
  Note: '''
    Modelo da coleção usuarios e sua relação com o catálogo de tecnologias.
    Campos sociais estão no schema; regras de autenticação, privacidade e atualização continuam parciais.
    DBML é usado como notação visual; arrays e subdocumentos representam estruturas MongoDB.
  '''
}

Enum visibilidade_perfil {
  publico
  privado
}

Enum papel_usuario {
  usuario
  moderador
  administrador
}

Enum status_usuario {
  ativo
  bloqueado
  excluido
}

Table usuarios [headercolor: #3B82F6, note: 'Schema implementado; campos sociais não implicam fluxos de produto prontos.'] {
  _id ObjectId [pk, not null, note: 'Identificador imutável.']

  nome string [not null, note: 'Baseline existente.']
  email string [not null, unique, note: 'Baseline; normalizado em minúsculas.']
  username string [not null, unique, note: 'Baseline; normalizado em minúsculas.']
  senha_hash string [not null, note: 'Baseline; confidencial e nunca retornado publicamente.']

  biografia string [note: 'Baseline; opcional.']
  avatar_url string [note: 'Baseline; opcional. Guarda referência, não o arquivo.']

  stack_ids ObjectId[] [note: 'Até 20 referências distintas; existência e atividade exigem serviço de perfil.']
  visibilidade_perfil visibilidade_perfil [not null, default: 'publico', note: 'Ainda não controla leitura do perfil.']
  papeis papel_usuario[] [not null, default: `['usuario']`, note: 'Valores únicos; ainda sem gestão administrativa.']
  status status_usuario [not null, default: 'ativo', note: 'Ainda não bloqueia login.']

  "contadores.publicacoes" int [not null, default: 0, note: 'Projeção modelada; serviço ainda não mantém este valor.']
  "contadores.seguidores" int [not null, default: 0, note: 'Projeção modelada; serviço ainda não mantém este valor.']
  "contadores.seguindo" int [not null, default: 0, note: 'Projeção modelada; serviço ainda não mantém este valor.']
  "contadores.score" int [not null, default: 0, note: 'Projeção modelada; pode ser negativo.']

  email_verificado_em datetime [note: 'Nulo enquanto não houver verificação.']
  termos_aceitos_em datetime [note: 'Deve acompanhar a versão aceita.']
  versao_termos_aceita string

  criado_em datetime [not null, note: 'Baseline existente; imutável após criação.']
  atualizado_em datetime [not null]
  excluido_em datetime [note: 'Preenchido somente quando status for excluido.']

  indexes {
    email [unique, name: 'uq_usuarios_email']
    username [unique, name: 'uq_usuarios_username']
  }
}

Table tecnologias [headercolor: #10B981, note: 'Schema implementado; catálogo compartilhado de stacks.'] {
  _id ObjectId [pk, not null]
  nome string [not null]
  slug string [not null, unique]
  categoria string
  icone_url string
  ativo boolean [not null, default: true]
  criado_em datetime [not null]
  atualizado_em datetime [not null]

  indexes {
    slug [unique, name: 'uq_tecnologias_slug']
    (ativo, nome, _id) [name: 'ix_tecnologias_ativas_nome']
  }
}

Ref usuario_tecnologias: usuarios.stack_ids <> tecnologias._id

